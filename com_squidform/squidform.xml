<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
	<name>com_squidform</name>
	<author>SquidForm Team</author>
	<creationDate>2026-11-16</creationDate>
	<copyright>(C) 2026 SquidForm</copyright>
	<license>GNU General Public License version 2 or later</license>
	<version>1.0.3</version>
	<description>COM_SQUIDFORM_XML_DESCRIPTION</description>
	<namespace path="src">SquidForm\Component\SquidForm</namespace>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<files folder="site">
		<folder>layouts</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>

	<media destination="com_squidform" folder="media">
		<filename>joomla.asset.json</filename>
		<folder>css</folder>
		<folder>js</folder>
	</media>

	<administration>
		<menu img="class:list">COM_SQUIDFORM</menu>
		<submenu>
			<menu link="option=com_squidform&amp;view=forms" view="forms">COM_SQUIDFORM_SUBMENU_FORMS</menu>
			<menu link="option=com_squidform&amp;view=submissions" view="submissions">COM_SQUIDFORM_SUBMENU_SUBMISSIONS</menu>
			<menu link="option=com_squidform&amp;view=resumes" view="resumes">COM_SQUIDFORM_SUBMENU_RESUMES</menu>
			<menu link="option=com_squidform&amp;view=delegates" view="delegates">COM_SQUIDFORM_SUBMENU_DELEGATES</menu>
			<menu link="option=com_squidform&amp;view=activity" view="activity">COM_SQUIDFORM_SUBMENU_ACTIVITY</menu>
			<menu link="option=com_squidform&amp;view=datatables" view="datatables">COM_SQUIDFORM_SUBMENU_DATATABLES</menu>
		</submenu>
		<files folder="admin">
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>examples</folder>
			<folder>forms</folder>
			<folder>layouts</folder>
			<folder>language</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
	</administration>
</extension>
